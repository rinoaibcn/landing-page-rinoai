{
  "name": "rinoai",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Sin barra final, como en Vercel: /servicios sirve servicios/index.html y /servicios/ redirige.
    "html_handling": "drop-trailing-slash",
    // El worker solo se ejecuta en estas rutas; el resto son archivos estáticos (gratis y sin límite).
    "run_worker_first": ["/", "/api/*", "/.well-known/api-catalog", "/index.md", "/llms.txt", "/google*.html"]
  },
  "routes": [{ "pattern": "rinoai.es", "custom_domain": true }],
  "observability": { "enabled": true }
}
